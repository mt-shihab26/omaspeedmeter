#!/bin/bash
# Emits one line of JSON with current system stats for the sysmon bar widget.
# Deltas (CPU%, network rate) are computed against the previous invocation,
# cached in a small state file, so this script must be polled periodically
# by the widget rather than run once.
set -uo pipefail

STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-sysmon"
STATE_FILE="$STATE_DIR/state"
mkdir -p "$STATE_DIR"

TEMP_ZONE="auto"
NET_IFACE="auto"
GPU_VENDOR="auto"

while (( $# > 0 )); do
  case "$1" in
    --temp-zone) TEMP_ZONE="${2:-auto}"; shift 2 ;;
    --net-iface) NET_IFACE="${2:-auto}"; shift 2 ;;
    --gpu-vendor) GPU_VENDOR="${2:-auto}"; shift 2 ;;
    *) shift ;;
  esac
done

now=$(date +%s.%N)

# ---------------------------------------------------------------- previous state
prev_ts=""
prev_total=0
prev_idle=0
prev_rx=0
prev_tx=0
if [[ -f "$STATE_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$STATE_FILE" 2>/dev/null || true
fi

# --------------------------------------------------------------------------- cpu
read -r _ cu cn cs ci ciow cirq csirq cst _ < /proc/stat
cpu_idle=$((ci + ciow))
cpu_total=$((cu + cn + cs + ci + ciow + cirq + csirq + cst))

cpu_pct=0
if [[ -n "$prev_ts" ]]; then
  d_total=$((cpu_total - prev_total))
  d_idle=$((cpu_idle - prev_idle))
  if (( d_total > 0 )); then
    cpu_pct=$(awk -v dt="$d_total" -v di="$d_idle" 'BEGIN { p = (dt-di)/dt*100; if (p<0) p=0; if (p>100) p=100; printf "%.0f", p }')
  fi
fi

# --------------------------------------------------------------------------- mem
mem_total=0
mem_avail=0
while read -r key value _; do
  case "$key" in
    MemTotal:) mem_total=$value ;;
    MemAvailable:) mem_avail=$value ;;
  esac
done < /proc/meminfo
mem_pct=0
if (( mem_total > 0 )); then
  mem_pct=$(awk -v t="$mem_total" -v a="$mem_avail" 'BEGIN { printf "%.0f", (t-a)/t*100 }')
fi

# --------------------------------------------------------------------------- net
iface="$NET_IFACE"
if [[ "$iface" == "auto" || -z "$iface" ]]; then
  iface=$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')
fi

rx=0
tx=0
if [[ -n "$iface" && -r "/sys/class/net/$iface/statistics/rx_bytes" ]]; then
  rx=$(<"/sys/class/net/$iface/statistics/rx_bytes")
  tx=$(<"/sys/class/net/$iface/statistics/tx_bytes")
fi

rx_rate=0
tx_rate=0
if [[ -n "$prev_ts" ]]; then
  dt=$(awk -v a="$now" -v b="$prev_ts" 'BEGIN { d=a-b; if (d<=0) d=1; printf "%.3f", d }')
  if (( rx >= prev_rx )); then
    rx_rate=$(awk -v d="$((rx - prev_rx))" -v dt="$dt" 'BEGIN { printf "%.0f", d/dt }')
  fi
  if (( tx >= prev_tx )); then
    tx_rate=$(awk -v d="$((tx - prev_tx))" -v dt="$dt" 'BEGIN { printf "%.0f", d/dt }')
  fi
fi

# -------------------------------------------------------------------------- temp
temp_c="null"
temp_path=""
if [[ "$TEMP_ZONE" != "none" ]]; then
  if [[ -n "$TEMP_ZONE" && "$TEMP_ZONE" != "auto" && -r "$TEMP_ZONE" ]]; then
    temp_path="$TEMP_ZONE"
  else
    best=-1
    for zone in /sys/class/thermal/thermal_zone*/temp; do
      [[ -r "$zone" ]] || continue
      v=$(<"$zone")
      [[ "$v" =~ ^[0-9]+$ ]] || continue
      if (( v > best )); then best=$v; temp_path="$zone"; fi
    done
  fi
  if [[ -n "$temp_path" && -r "$temp_path" ]]; then
    raw=$(<"$temp_path")
    if [[ "$raw" =~ ^[0-9]+$ ]]; then
      temp_c=$(awk -v r="$raw" 'BEGIN { printf "%.0f", r/1000 }')
    fi
  fi
fi

# --------------------------------------------------------------------------- gpu
gpu_pct="null"
vendor="$GPU_VENDOR"
detect_vendor() {
  if command -v nvidia-smi >/dev/null 2>&1; then
    echo "nvidia"
  elif compgen -G "/sys/class/drm/card*/device/gpu_busy_percent" > /dev/null; then
    echo "amd"
  elif command -v intel_gpu_top >/dev/null 2>&1; then
    echo "intel"
  else
    echo "none"
  fi
}
[[ "$vendor" == "auto" ]] && vendor=$(detect_vendor)

case "$vendor" in
  nvidia)
    if command -v nvidia-smi >/dev/null 2>&1; then
      v=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -dc '0-9')
      [[ -n "$v" ]] && gpu_pct="$v"
    fi
    ;;
  amd)
    f=$(compgen -G "/sys/class/drm/card*/device/gpu_busy_percent" | head -1)
    if [[ -n "$f" && -r "$f" ]]; then
      v=$(<"$f")
      [[ "$v" =~ ^[0-9]+$ ]] && gpu_pct="$v"
    fi
    ;;
  intel)
    if command -v intel_gpu_top >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      v=$(timeout 1 intel_gpu_top -J -o - -s 200 -n 1 2>/dev/null | jq -r '.[0].engines["Render/3D"].busy // empty' 2>/dev/null)
      [[ -n "$v" ]] && gpu_pct=$(awk -v r="$v" 'BEGIN { p=r+0; if(p<0)p=0; if(p>100)p=100; printf "%.0f", p }')
    fi
    ;;
esac

# ------------------------------------------------------------------------ procs
proc_count=$(compgen -G "/proc/[0-9]*" | wc -l)

# ------------------------------------------------------------------------- save
{
  echo "prev_ts=$now"
  echo "prev_total=$cpu_total"
  echo "prev_idle=$cpu_idle"
  echo "prev_rx=$rx"
  echo "prev_tx=$tx"
} > "$STATE_FILE"

printf '{"cpu":%s,"mem":%s,"rx":%s,"tx":%s,"temp":%s,"gpu":%s,"procs":%s,"iface":"%s"}\n' \
  "$cpu_pct" "$mem_pct" "$rx_rate" "$tx_rate" "$temp_c" "$gpu_pct" "$proc_count" "$iface"
